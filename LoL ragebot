-- ══════════════════════════════════
--  VOID SPAM  (FE-safe)
--  • kills LocalPlayer client-side
--  • uses Humanoid.Health = 0
--    (local only, no server write)
--  • loops with respawn wait
-- ══════════════════════════════════
local voidThread = nil

local function startVoidSpam()
    voidThread = task.spawn(function()
        while voidSpamEnabled do
            local hrp = getHRP()
            local h   = getHuman()
            if hrp then
                -- Teleport below map void plane (FE: moves local char visually)
                hrp.CFrame = CFrame.new(hrp.Position.X, -500, hrp.Position.Z)
            end
            task.wait(0.08)
            -- Force death
            if h and h.Health > 0 then
                h.Health = 0
            end
            -- Wait for respawn (poll up to 6s)
            local elapsed = 0
            repeat
                task.wait(0.05)
                elapsed = elapsed + 0.05
            until (getHRP() ~= nil and getHuman() ~= nil and getHuman().Health > 0)
                  or elapsed > 6
            task.wait(0.05)  -- small buffer before next cycle
        end
    end)
end

local function stopVoidSpam()
    if voidThread then
        task.cancel(voidThread)
        voidThread = nil
    end
end

VoidBtn.MouseButton1Click:Connect(function()
    voidSpamEnabled = not voidSpamEnabled
    if voidSpamEnabled then
        activateBtn(VoidDot, VoidBar, VoidStatus, Color3.fromRGB(50, 220, 50))
        startVoidSpam()
    else
        deactivateBtn(VoidDot, VoidBar, VoidStatus)
        stopVoidSpam()
    end
end)

-- ══════════════════════════════════
--  RAGEBOT  (FE-safe)
--  • RenderStepped scan (client only)
--  • silent aim via Camera.CFrame
--  • fires weapon remote locally
-- ══════════════════════════════════
local RAGEBOT_FOV  = 360
local RAGEBOT_BONE = "HumanoidRootPart"
local ragebotConn  = nil

local function getScreenAngle(worldPos)
    local sp, onScreen = Camera:WorldToScreenPoint(worldPos)
    if not onScreen then return math.huge end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local delta  = Vector2.new(sp.X, sp.Y) - center
    return math.deg(math.atan2(delta.Magnitude, Camera.ViewportSize.Y / 2))
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end
    return true
end

local function getBestTarget()
    local best, bestAng = nil, RAGEBOT_FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if not isEnemy(p) then continue end
        local c = p.Character
        if not c then continue end
        local bone = c:FindFirstChild(RAGEBOT_BONE)
        if not bone then continue end
        local h = c:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then continue end
        local ang = getScreenAngle(bone.Position)
        if ang < bestAng then
            bestAng = ang
            best    = p
        end
    end
    return best
end

local function silentAimAt(pos)
    local dir = (pos - Camera.CFrame.Position).Unit
    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + dir)
end

local function fireTool()
    local c = getChar()
    if not c then return end
    local tool = c:FindFirstChildOfClass("Tool")
    if not tool then return end
    -- try known Rivals weapon remotes
    for _, name in ipairs({"Fire","Shoot","Activate","Attack","Use"}) do
        local r = tool:FindFirstChild(name)
        if r and r:IsA("RemoteEvent") then
            r:FireServer()
            return
        end
    end
    pcall(function() tool:Activate() end)
end

local function startRagebot()
    ragebotConn = RunService.RenderStepped:Connect(function()
        if not ragebotEnabled then return end
        local target = getBestTarget()
        if not target then return end
        local c    = target.Character
        if not c then return end
        local bone = c:FindFirstChild(RAGEBOT_BONE)
        if not bone then return end
        silentAimAt(bone.Position)
        fireTool()
    end)
end

local function stopRagebot()
    if ragebotConn then
        ragebotConn:Disconnect()
        ragebotConn = nil
    end
end

RageBtn.MouseButton1Click:Connect(function()
    ragebotEnabled = not ragebotEnabled
    if ragebotEnabled then
        activateBtn(RageDot, RageBar, RageStatus, Color3.fromRGB(220, 50, 50))
        startRagebot()
    else
        deactivateBtn(RageDot, RageBar, RageStatus)
        stopRagebot()
    end
end)

-- ══════════════════════════════════
--  UNLOCK ALL COSMETICS (LOCAL/VISUAL)
--  • scans StarterCharacter /
--    character accessories
--  • forcefully adds every accessory
--    found in ReplicatedStorage or
--    workspace cosmetic folders
--    to the LOCAL character only
--  • server does NOT see this (FE wall)
-- ══════════════════════════════════
local function scanAndEquipCosmetics()
    local char = getChar()
    if not char then return end

    -- common folder names Rivals uses for cosmetic storage
    local searchRoots = {
        ReplicatedStorage:FindFirstChild("Cosmetics"),
        ReplicatedStorage:FindFirstChild("Items"),
        ReplicatedStorage:FindFirstChild("Skins"),
        workspace:FindFirstChild("Cosmetics"),
    }

    local equipped = 0

    for _, root in ipairs(searchRoots) do
        if not root then continue end
        -- walk all descendants looking for Accessory instances
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("Accessory") then
                local clone = obj:Clone()
                -- parent to character → Roblox auto-attaches to humanoid
                clone.Parent = char
                equipped = equipped + 1
            end
        end
    end

    -- Fallback: clone accessories from other players (visible ones in workspace)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = p.Character
        if not c then continue end
        for _, obj in ipairs(c:GetChildren()) do
            if obj:IsA("Accessory") then
                local alreadyHave = false
                for _, mine in ipairs(char:GetChildren()) do
                    if mine.Name == obj.Name then
                        alreadyHave = true
                        break
                    end
                end
                if not alreadyHave then
                    obj:Clone().Parent = char
                    equipped = equipped + 1
                end
            end
        end
    end

    print("[RivalsHub] Cosmetics equipped locally:", equipped)
    return equipped
end

CosBtn.MouseButton1Click:Connect(function()
    cosmeticsUnlocked = not cosmeticsUnlocked
    if cosmeticsUnlocked then
        activateBtn(CosDot, CosBar, CosStatus, Color3.fromRGB(180, 120, 255))
        local n = scanAndEquipCosmetics()
        CosStatus.Text = "ON · " .. (n or 0) .. " items"
        -- re-run on respawn so cosmetics persist across deaths
        LocalPlayer.CharacterAdded:Connect(function()
            if cosmeticsUnlocked then
                task.wait(1)  -- wait for char to load
                scanAndEquipCosmetics()
            end
        end)
    else
        deactivateBtn(CosDot, CosBar, CosStatus)
        -- remove locally added accessories
        local char = getChar()
        if char then
            for _, obj in ipairs(char:GetChildren()) do
                if obj:IsA("Accessory") then
                    obj:Destroy()
                end
            end
        end
    end
end)

