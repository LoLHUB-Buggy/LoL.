local function smoothAimAt(worldPos)
    local camPos   = Camera.CFrame.Position
    local targetCF = CFrame.lookAt(camPos, worldPos)
    Camera.CFrame  = Camera.CFrame:Lerp(targetCF, STATE.AimbotSmooth)
end

