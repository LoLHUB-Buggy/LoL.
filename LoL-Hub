-- ============================================================
--  MAIN HEARTBEAT  (aim logic)
-- ============================================================

installSilentHook()
setupFOVCircle()

RunService.Heartbeat:Connect(function()
    spoofedPos = nil

    local mobileActive = IS_MOBILE and STATE.MobileLock

    -- RAGEBOT
    if STATE.Ragebot and (not IS_MOBILE or mobileActive) then
        local target = getRagebotTarget()
        if target then
            local bonePos = getBone(target, "Head", true)
            if bonePos then
                enableWallbang(bonePos)
                scheduleWallbangRestore()
                spoofedPos = bonePos
                if STATE.SilentAim then
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, bonePos)
                end
                if STATE.Triggerbot then triggerFire() end
            end
        end

    -- SILENT AIM ONLY
    elseif STATE.SilentAim and (not IS_MOBILE or mobileActive) then
        local target = getClosestTarget()
        if target then
            local bonePos = getBone(target, "Head", true)
            if bonePos then
                enableWallbang(bonePos)
                scheduleWallbangRestore()
                spoofedPos = bonePos
            end
        end
    end

    -- CLASSIC AIMBOT (PC: hold Q)
    if STATE.AimbotEnabled and not IS_MOBILE then
        if UIS:IsKeyDown(Enum.KeyCode.Q) then
            local target = getClosestTarget()
            if target then
                local bonePos = getBone(target, "Head", true)
                if bonePos then smoothAimAt(bonePos) end
            end
        end
    end

    updateFOVCircle()
    updateESP()
end)

