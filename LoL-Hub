-- ============================================================
--  ESP  (Drawing API boxes + names + health)
-- ============================================================

local espObjects = {}  -- {player -> {box, name, health}}

local function getOrCreateESP(player)
    if espObjects[player] then return espObjects[player] end
    if not Drawing then return nil end

    local box = Drawing.new("Square")
    box.Visible   = false
    box.Filled    = false
    box.Thickness = 1.5
    box.Color     = Color3.fromRGB(255, 50, 50)

    local nameLabel = Drawing.new("Text")
    nameLabel.Visible  = false
    nameLabel.Size     = 13
    nameLabel.Center   = true
    nameLabel.Outline  = true
    nameLabel.Color    = Color3.new(1,1,1)

    local healthBar = Drawing.new("Square")
    healthBar.Visible   = false
    healthBar.Filled    = true
    healthBar.Color     = Color3.fromRGB(60, 200, 80)
    healthBar.Thickness = 1

    local distLabel = Drawing.new("Text")
    distLabel.Visible  = false
    distLabel.Size     = 11
    distLabel.Center   = true
    distLabel.Outline  = true
    distLabel.Color    = Color3.fromRGB(200, 200, 200)

    local obj = {box = box, name = nameLabel, health = healthBar, dist = distLabel}
    espObjects[player] = obj
    return obj
end

local function removeESP(player)
    local obj = espObjects[player]
    if not obj then return end
    for _, v in pairs(obj) do
        pcall(function() v:Remove() end)
    end
    espObjects[player] = nil
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local obj = getOrCreateESP(player)
        if not obj then continue end

        local char = player.Character
        local hide = not STATE.ESPEnabled
                  or not char
                  or not isValid(player, STATE.ESPTeamCheck, true)

        if hide then
            obj.box.Visible    = false
            obj.name.Visible   = false
            obj.health.Visible = false
            obj.dist.Visible   = false
            continue
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not head or not hum then
            obj.box.Visible = false
            continue
        end

        -- distance check
        local myRoot = LocalPlayer.Character
                       and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist3d = myRoot and (root.Position - myRoot.Position).Magnitude or 0
        if dist3d > STATE.ESPMaxDist then
            obj.box.Visible = false
            obj.name.Visible = false
            obj.health.Visible = false
            obj.dist.Visible = false
            continue
        end

        -- project corners
        local topPos    = head.Position + Vector3.new(0, 0.7, 0)
        local bottomPos = root.Position - Vector3.new(0, 2.5, 0)

        local topScreen,    topVis,    topDepth    = w2s(topPos)
        local bottomScreen, bottomVis, bottomDepth = w2s(bottomPos)

        if not topVis or not bottomVis or topDepth <= 0 then
            obj.box.Visible = false
            obj.name.Visible = false
            obj.health.Visible = false
            obj.dist.Visible = false
            continue
        end

        local boxH = math.abs(bottomScreen.Y - topScreen.Y)
        local boxW = boxH * 0.55
        local boxX = topScreen.X - boxW / 2
        local boxY = topScreen.Y

        -- box
        if STATE.ESPBoxes then
            obj.box.Visible   = true
            obj.box.Position  = Vector2.new(boxX, boxY)
            obj.box.Size      = Vector2.new(boxW, boxH)
        else
            obj.box.Visible = false
        end

        -- name
        if STATE.ESPNames then
            obj.name.Visible   = true
            obj.name.Text      = player.Name
            obj.name.Position  = Vector2.new(topScreen.X, boxY - 16)
        else
            obj.name.Visible = false
        end

        -- health bar (left of box)
        if STATE.ESPHealth then
            local hpRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local barH    = boxH * hpRatio
            obj.health.Visible  = true
            obj.health.Size     = Vector2.new(3, barH)
            obj.health.Position = Vector2.new(boxX - 6, boxY + boxH - barH)
            obj.health.Color    = Color3.fromRGB(
                math.floor(255 * (1 - hpRatio)),
                math.floor(255 * hpRatio),
                0
            )
        else
            obj.health.Visible = false
        end

        -- distance
        if STATE.ESPDistance then
            obj.dist.Visible  = true
            obj.dist.Text     = math.floor(dist3d) .. "m"
            obj.dist.Position = Vector2.new(topScreen.X, boxY + boxH + 2)
        else
            obj.dist.Visible = false
        end
    end
end

