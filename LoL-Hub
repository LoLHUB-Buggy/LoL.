local function toggle(panel, text, init, risk, cb)
    local row = Instance.new("TextButton", panel)
    row.Size = UDim2.new(1,0,0,ROW_H) ; row.BackgroundColor3 = C.BG
    row.BorderSizePixel = 0 ; row.Text = "" ; row.AutoButtonColor = false
    Instance.new("UICorner", row).CornerRadius = UDim.new(0,5)

    local box = Instance.new("Frame", row)
    box.Size = UDim2.new(0,IS_MOBILE and 16 or 12, 0,IS_MOBILE and 16 or 12)
    box.Position = UDim2.new(1,IS_MOBILE and -28 or -22, 0.5,IS_MOBILE and -8 or -6)
    box.BackgroundColor3 = init and C.ON or C.OFF
    box.BorderSizePixel = 0
    Instance.new("UICorner", box).CornerRadius = UDim.new(0,3)

    local tick = Instance.new("TextLabel", box)
    tick.Size = UDim2.new(1,0,1,0) ; tick.BackgroundTransparency = 1
    tick.Text = init and "✓" or "" ; tick.TextColor3 = Color3.new(1,1,1)
    tick.TextSize = IS_MOBILE and 11 or 9 ; tick.Font = Enum.Font.GothamBold
    tick.TextXAlignment = Enum.TextXAlignment.Center

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1,-40,1,0) ; lbl.Position = UDim2.new(0,10,0,0)
    lbl.BackgroundTransparency = 1 ; lbl.Text = text
    lbl.TextColor3 = risk and C.RISK or C.TEXT
    lbl.TextSize = FONT_SZ ; lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local state = init
    local function refresh()
        box.BackgroundColor3 = state and C.ON or C.OFF
        tick.Text = state and "✓" or ""
        row.BackgroundColor3 = state and C.HOVER or C.BG
    end

    row.MouseButton1Click:Connect(function()
        state = not state ; refresh()
        if cb then cb(state) end
    end)
    row.MouseEnter:Connect(function() row.BackgroundColor3 = C.HOVER end)
    row.MouseLeave:Connect(function()
        row.BackgroundColor3 = state and C.HOVER or C.BG
    end)
end

local function labelRow(panel, left, right, accent)
    local row = Instance.new("Frame", panel)
    row.Size = UDim2.new(1,0,0,ROW_H) ; row.BackgroundTransparency = 1 ; row.BorderSizePixel = 0
    local l = Instance.new("TextLabel", row)
    l.Size = UDim2.new(0.6,0,1,0) ; l.BackgroundTransparency = 1
    l.Text = left ; l.TextColor3 = C.SUBTEXT ; l.TextSize = FONT_SZ
    l.Font = Enum.Font.Gotham ; l.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UIPadding", l).PaddingLeft = UDim.new(0,10)
    local r = Instance.new("TextLabel", row)
    r.Size = UDim2.new(0.4,0,1,0) ; r.Position = UDim2.new(0.6,0,0,0)
    r.BackgroundTransparency = 1 ; r.Text = right
    r.TextColor3 = accent and C.ACCENT or C.TEXT ; r.TextSize = FONT_SZ
    r.Font = Enum.Font.GothamBold ; r.TextXAlignment = Enum.TextXAlignment.Right
    Instance.new("UIPadding", r).PaddingRight = UDim.new(0,10)
end

local function buttonRow(panel, text, risk, cb)
    local btn = Instance.new("TextButton", panel)
    btn.Size = UDim2.new(1,0,0,ROW_H)
    btn.BackgroundColor3 = risk and C.RISK or C.PANEL
    btn.Text = text ; btn.TextColor3 = Color3.new(1,1,1)
    btn.TextSize = FONT_SZ ; btn.Font = Enum.Font.GothamBold
