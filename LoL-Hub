local activeTab  = "main"
local tabBtnRefs = {}

local function switchTab(name)
    for _, t in ipairs(TABS) do
        if tabPanels[t] then tabPanels[t].Visible = (t == name) end
    end
    for _, ref in pairs(tabBtnRefs) do
        local on = ref.name == name
        ref.btn.BackgroundColor3 = on and C.TAB_ACT or C.TAB_IN
        ref.btn.TextColor3       = on and Color3.new(1,1,1) or C.SUBTEXT
        ref.btn.Font             = on and Enum.Font.GothamBold or Enum.Font.Gotham
    end
    activeTab = name
end

