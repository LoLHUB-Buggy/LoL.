-- ============================================================
--  UTILITY
-- ============================================================

local function w2s(pos)
    local v, vis, depth = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), vis, depth
end

local function screenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2,
                       Camera.ViewportSize.Y / 2)
end

local function centerDist(sp)
    return (sp - screenCenter()).Magnitude
end

local function isValid(player, teamCheck, aliveCheck)
    if player == LocalPlayer then return false end
    if teamCheck then
        if player.Team and LocalPlayer.Team then
            if player.Team == LocalPlayer.Team then return false end
        end
    end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if aliveCheck and hum.Health <= 0 then return false end
    if not char:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local function getBone(player, boneName, predict)
    local char = player.Character
    if not char then return nil end
    local part = char:FindFirstChild(boneName)
               or char:FindFirstChild("HumanoidRootPart")
    if not part then return nil end
    local pos = part.Position
    if predict and STATE.Prediction then
        local vel = part.AssemblyLinearVelocity
        if vel then pos = pos + vel * STATE.PredFactor end
    end
    return pos
end

-- ============================================================
--  WALLBANG
-- ============================================================

local wallActive = false
local savedParts = {}

local function collectWalls(targetPos)
    local camPos  = Camera.CFrame.Position
    local dir     = (targetPos - camPos)
    local unitDir = dir.Unit
    local dist    = dir.Magnitude

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}

    local walls = {}
    local origin = camPos
    local remaining = dist
    local pen = 0

    while remaining > 0.5 and pen < 8 do
        local result = Workspace:Raycast(origin, unitDir * remaining, params)
        if not result then break end
        local hit = result.Instance
        if Players:GetPlayerFromCharacter(hit.Parent) then break end
        if hit:IsA("BasePart") and hit.CanQuery then
            table.insert(walls, {part = hit, orig = hit.CanQuery})
        end
        pen       = pen + (result.Distance or 0)
        origin    = result.Position + unitDir * 0.05
        remaining = (targetPos - origin).Magnitude
    end
    return walls
end

local function enableWallbang(targetPos)
    if not STATE.Wallbang then return end
    wallActive = true
    savedParts = collectWalls(targetPos)
    for _, e in ipairs(savedParts) do
        pcall(function() e.part.CanQuery = false end)
    end
end

local function disableWallbang()
    if not wallActive then return end
    for _, e in ipairs(savedParts) do
        pcall(function() e.part.CanQuery = e.orig end)
    end
    savedParts = {}
    wallActive = false
end

local function scheduleWallbangRestore()
    task.delay(0.12, disableWallbang)
end

-- ============================================================
--  SILENT AIM HOOK
-- ============================================================

local spoofedPos      = nil
local silentInstalled = false

local function buildRay(worldPos)
    local camPos = Camera.CFrame.Position
    return Ray.new(camPos, (worldPos - camPos).Unit * 5000)
end

local function installSilentHook()
    local mt = getrawmetatable and getrawmetatable(Mouse)
    if not mt then
        warn("[LoL Hub] getrawmetatable unavailable")
        return false
    end
    local oldIndex = rawget(mt, "__index")
    if setreadonly    then setreadonly(mt, false)  end
    if make_writeable then make_writeable(mt)      end

    rawset(mt, "__index", newcclosure(function(self, key)
        if spoofedPos then
            if key == "Hit"     then return CFrame.new(spoofedPos) end
            if key == "UnitRay" then return buildRay(spoofedPos)   end
            if key == "Target"  then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local bone = p.Character:FindFirstChild("Head")
                        if bone then
                            local sp, vis = w2s(bone.Position)
                            if vis and centerDist(sp) < STATE.FOV then
                                return bone
                            end
                        end
                    end
                end
            end
        end
        if type(oldIndex) == "function" then return oldIndex(self, key) end
        return rawget(self, key)
    end))

    silentInstalled = true
    return true
end

-- ============================================================
--  TARGET ACQUISITION
-- ============================================================

local MULTIPOINT_BONES = {"Head", "UpperTorso", "HumanoidRootPart"}

local function getRagebotTarget()
    local bestPlayer = nil
    local bestDist   = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if isValid(player, true, true) then
            local bones = STATE.Multipoint and MULTIPOINT_BONES or {"Head"}
            for _, bone in ipairs(bones) do
                local pos = getBone(player, bone, true)
                if pos then
                    local sp, vis, depth = w2s(pos)
                    if vis and depth > 0 then
                        local dist = centerDist(sp)
                        local inRange = STATE.NoFOVLimit or (dist < STATE.FOV)
                        if inRange and dist < bestDist then
                            bestDist   = dist
                            bestPlayer = player
                        end
                    end
                end
            end
        end
    end
    return bestPlayer
end

local function getClosestTarget()
    local bestPlayer = nil
    local bestDist   = STATE.FOV
    for _, player in ipairs(Players:GetPlayers()) do
        if isValid(player, true, true) then
            local pos = getBone(player, "Head", true)
            if pos then
                local sp, vis, depth = w2s(pos)
                if vis and depth > 0 then
                    local dist = centerDist(sp)
                    if dist < bestDist then
                        bestDist   = dist
                        bestPlayer = player
                    end
                end
            end
        end
    end
    return bestPlayer
end

