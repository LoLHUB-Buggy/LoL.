    -- Larger pill on mobile for fat fingers
    local PW=IsMobile and 46 or 36; local PH=IsMobile and 24 or 18
    local KS=IsMobile and 18 or 13

    local pill=Instance.new("Frame"); pill.Size=UDim2.new(0,PW,0,PH); pill.Position=UDim2.new(1,-(PW+10),0.5,-PH/2); pill.BorderSizePixel=0; pill.BackgroundColor3=CFG[cfgKey] and P.ACCENT or P.OFF; pill.Parent=row
    do local c=Instance.new("UICorner") c.CornerRadius=UDim.new(1,0) c.Parent=pill end

    local knob=Instance.new("Frame"); knob.Size=UDim2.new(0,KS,0,KS); knob.BorderSizePixel=0; knob.BackgroundColor3=P.WHITE; knob.Position=CFG[cfgKey] and UDim2.new(1,-(KS+2),0.5,-KS/2) or UDim2.new(0,2,0.5,-KS/2); knob.Parent=pill
    do local c=Instance.new("UICorner") c.CornerRadius=UDim.new(1,0) c.Parent=knob end

    local function refresh()
        local on=CFG[cfgKey]
        TweenService:Create(pill,TweenInfo.new(0.12),{BackgroundColor3=on and P.ACCENT or P.OFF}):Play()
        TweenService:Create(knob,TweenInfo.new(0.12),{Position=on and UDim2.new(1,-(KS+2),0.5,-KS/2) or UDim2.new(0,2,0.5,-KS/2)}):Play()
    end

    local btn=Instance.new("TextButton"); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""; btn.Parent=row
    btn.MouseButton1Click:Connect(function() CFG[cfgKey]=not CFG[cfgKey]; refresh() end)
    return row
end

-- Slider — touch drag supported
local function Slider(parent,label,cfgKey,minV,maxV,order)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,SLD_H); row.BackgroundColor3=P.PANEL; row.BorderSizePixel=0; row.LayoutOrder=order or 0; row.Parent=parent
    do local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,6) c.Parent=row end
    do local s=Instance.new("UIStroke") s.Color=P.OUTLINE s.Thickness=1 s.Parent=row end

    local lbl=Instance.new("TextLabel"); lbl.Text="  "..label; lbl.Size=UDim2.new(1,-60,0,22); lbl.Position=UDim2.new(0,0,0,4); lbl.BackgroundTransparency=1; lbl.TextColor3=P.TEXT; lbl.TextSize=TXT_SZ; lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row
    local valLbl=Instance.new("TextLabel"); valLbl.Size=UDim2.new(0,52,0,22); valLbl.Position=UDim2.new(1,-56,0,4); valLbl.BackgroundTransparency=1; valLbl.TextColor3=P.ACCENT; valLbl.TextSize=11; valLbl.Font=Enum.Font.GothamMedium; valLbl.TextXAlignment=Enum.TextXAlignment.Right; valLbl.Text=tostring(CFG[cfgKey]); valLbl.Parent=row

    -- Thicker track + bigger thumb for mobile
    local TRACK_H=IsMobile and 7 or 4; local THUMB_S=IsMobile and 16 or 10

    local track=Instance.new("Frame"); track.Size=UDim2.new(1,-20,0,TRACK_H); track.Position=UDim2.new(0,10,1,-TRACK_H-8); track.BackgroundColor3=P.OUTLINE; track.BorderSizePixel=0; track.Parent=row
    do local c=Instance.new("UICorner") c.CornerRadius=UDim.new(1,0) c.Parent=track end

    local ratio0=(CFG[cfgKey]-minV)/(maxV-minV)
    local fill=Instance.new("Frame"); fill.Size=UDim2.new(ratio0,0,1,0); fill.BackgroundColor3=P.ACCENT; fill.BorderSizePixel=0; fill.Parent=track
    do local c=Instance.new("UICorner") c.CornerRadius=UDim.new(1,0) c.Parent=fill end

    local thumb=Instance.new("Frame"); thumb.Size=UDim2.new(0,THUMB_S,0,THUMB_S); thumb.Position=UDim2.new(ratio0,-THUMB_S/2,0.5,-THUMB_S/2); thumb.BackgroundColor3=P.WHITE; thumb.BorderSizePixel=0; thumb.Parent=track
    do local c=Instance.new("UICorner") c.CornerRadius=UDim.new(1,0) c.Parent=thumb end

    local dragging=false

    local function applyInput(posX)
        local rel=math.clamp((posX-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local val=math.floor(minV+rel*(maxV-minV))
        CFG[cfgKey]=val; valLbl.Text=tostring(val)
        fill.Size=UDim2.new(rel,0,1,0)
        thumb.Position=UDim2.new(rel,-THUMB_S/2,0.5,-THUMB_S/2)
    end

    -- Mouse
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=true; applyInput(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType==Enum.UserInputType.MouseMovement then
            applyInput(inp.Position.X)
        end
    end)

    -- Touch
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.Touch then
            dragging=true; applyInput(inp.Position.X)
        end
    end)
    track.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)
    track.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType==Enum.UserInputType.Touch then
            applyInput(inp.Position.X)
        end
    end)

    return row
end

