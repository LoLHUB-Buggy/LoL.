-- ══════════════════════════════════════════════
--  UTILITY
-- ══════════════════════════════════════════════
local function w2s(pos)
    local s, vis = Camera:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), vis, s.Z
end
local function getChar(p)   return p and p.Character end
local function getRoot(c)   return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(c)    return c and c:FindFirstChildOfClass("Humanoid") end
local function getBone(c,b) return c and (c:FindFirstChild(b) or getRoot(c)) end
local function alive(p)
    local c = getChar(p); local h = c and getHum(c)
    return h and h.Health > 0
end
local function teammate(p)
    return CFG.AIM_TEAM_CHECK and p.Team == LocalPlayer.Team
end
local function dist3(a,b) return (a-b).Magnitude end

local function charBounds(char)
    local sx, sy = {}, {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local cf, sz = p.CFrame, p.Size/2
            for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
                local sc, vis = w2s(cf * Vector3.new(x*sz.X,y*sz.Y,z*sz.Z))
                if vis then sx[#sx+1]=sc.X; sy[#sy+1]=sc.Y end
            end end end
        end
    end
    if #sx==0 then return nil end
    local mnX,mxX,mnY,mxY = math.huge,-math.huge,math.huge,-math.huge
    for i=1,#sx do
        mnX=math.min(mnX,sx[i]); mxX=math.max(mxX,sx[i])
        mnY=math.min(mnY,sy[i]); mxY=math.max(mxY,sy[i])
    end
    return mnX, mnY, mxX-mnX, mxY-mnY
end

