end)

RunService.Heartbeat:Connect(function()
    local char=getChar(LocalPlayer); local hum=char and getHum(char); local root=char and getRoot(char)
    if not hum or not root then return end
    if CFG.SPEED_ENABLED then hum.WalkSpeed=CFG.SPEED_VALUE end
    if CFG.BHOP_ENABLED and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        if not root:FindFirstChildOfClass("BodyVelocity") then
            local bv=Instance.new("BodyVelocity")
            bv.Velocity=Vector3.new(root.Velocity.X,52,root.Velocity.Z)
            bv.MaxForce=Vector3.new(0,math.huge,0); bv.P=math.huge; bv.Parent=root
            game:GetService("Debris"):AddItem(bv,0.09)
        end
    end
    local tool=char:FindFirstChildOfClass("Tool")
    if tool then
        for _,v in ipairs(tool:GetDescendants()) do
            if CFG.INFINITE_AMMO and v:IsA("NumberValue") and v.Name:lower():match("ammo") then v.Value=9999 end
            if CFG.NO_SPREAD    and v:IsA("NumberValue") and v.Name:lower():match("spread") then v.Value=0 end
        end
    end
end)

