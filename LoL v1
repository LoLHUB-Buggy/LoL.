local CFGDIR="lolhub_configs/"
local function ensureDir() if not isfolder(CFGDIR) then makefolder(CFGDIR) end end
local function saveConfig(n) ensureDir(); local ok,s=pcall(HttpService.JSONEncode,HttpService,CFG); if ok then writefile(CFGDIR..n..".json",s) end end
local function loadConfig(n) ensureDir(); local p=CFGDIR..n..".json"; if isfile(p) then local ok,t=pcall(HttpService.JSONDecode,HttpService,readfile(p)); if ok and type(t)=="table" then for k,v in pairs(t) do CFG[k]=v end end end end
local function listConfigs() ensureDir(); local out={}; for _,f in ipairs(listfiles(CFGDIR)) do local n=f:match("([^/\\]+)%.json$"); if n then out[#out+1]=n end end return out end
