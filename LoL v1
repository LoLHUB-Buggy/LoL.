local espCache = {}

local function makeESP(player)
    local obj = {
        box   = {},
        name  = D("Text", {Size=13,Color=P.TEXT,   Outline=true,Center=true, Visible=false}),
        hpBg  = D("Line", {Thickness=4,Color=c3(20,20,20),                   Visible=false}),
        hpFg  = D("Line", {Thickness=3,Color=P.ON,                           Visible=false}),
        dist  = D("Text", {Size=11,Color=P.SUB,    Outline=true,Center=true, Visible=false}),
        trace = D("Line", {Thickness=1,Color=P.RED,                          Visible=false}),
    }
    for i=1,4 do obj.box[i]=D("Line",{Thickness=1.2,Color=P.RED,Visible=false}) end
    espCache[player]=obj
end

local function killESP(player)
    local o=espCache[player]; if not o then return end
    for _,l in ipairs(o.box) do l:Remove() end
    o.name:Remove();o.hpBg:Remove();o.hpFg:Remove();o.dist:Remove();o.trace:Remove()
    espCache[player]=nil
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        if not espCache[player] then makeESP(player) end
        local o    = espCache[player]
        local char = getChar(player)
        local root = getRoot(char)
        local hum  = getHum(char)
        local show = CFG.ESP_ENABLED and root and hum and hum.Health>0
                     and dist3(root.Position,Camera.CFrame.Position)<=CFG.ESP_MAX_DIST
        if not show then
            for _,l in ipairs(o.box) do l.Visible=false end
            o.name.Visible=false;o.hpBg.Visible=false
            o.hpFg.Visible=false;o.dist.Visible=false;o.trace.Visible=false
            continue
        end
        local col = teammate(player)
            and c3(CFG.ESP_TEAM_R,CFG.ESP_TEAM_G,CFG.ESP_TEAM_B)
            or  c3(CFG.ESP_ENEMY_R,CFG.ESP_ENEMY_G,CFG.ESP_ENEMY_B)
        local bx,by,bw,bh = charBounds(char)
        if not bx then for _,l in ipairs(o.box) do l.Visible=false end continue end
        if CFG.ESP_BOX then
            local pts = {
                {Vector2.new(bx,by),    Vector2.new(bx+bw,by)   },
                {Vector2.new(bx,by+bh), Vector2.new(bx+bw,by+bh)},
                {Vector2.new(bx,by),    Vector2.new(bx,by+bh)   },
                {Vector2.new(bx+bw,by), Vector2.new(bx+bw,by+bh)},
            }
            for i,ln in ipairs(o.box) do ln.From=pts[i][1];ln.To=pts[i][2];ln.Color=col;ln.Visible=true end
        else for _,l in ipairs(o.box) do l.Visible=false end end
        o.name.Text=player.DisplayName; o.name.Position=Vector2.new(bx+bw/2,by-16); o.name.Visible=CFG.ESP_NAME
        local hp=math.clamp(hum.Health/hum.MaxHealth,0,1)
        o.hpBg.From=Vector2.new(bx-6,by);   o.hpBg.To=Vector2.new(bx-6,by+bh)
        o.hpFg.From=Vector2.new(bx-6,by+bh);o.hpFg.To=Vector2.new(bx-6,by+bh-bh*hp)
        o.hpFg.Color=Color3.fromRGB(math.floor(255*(1-hp)),math.floor(255*hp),0)
        o.hpBg.Visible=CFG.ESP_HEALTH;o.hpFg.Visible=CFG.ESP_HEALTH
        local d=math.floor(dist3(root.Position,Camera.CFrame.Position))
        o.dist.Text="["..d.."]"; o.dist.Position=Vector2.new(bx+bw/2,by+bh+2); o.dist.Visible=CFG.ESP_DISTANCE
        local vps=Camera.ViewportSize
        o.trace.From=Vector2.new(vps.X/2,vps.Y); o.trace.To=Vector2.new(bx+bw/2,by+bh)
        o.trace.Color=col; o.trace.Visible=CFG.ESP_TRACERS
    end
end

-- ══════════════════════════════════════════════
--  AIMBOT + SILENT AIM
-- ══════════════════════════════════════════════
local fovCircle = D("Circle",{Thickness=1,Color=P.WHITE,Filled=false,NumSides=64,Visible=false})
local silentTarget = nil
local aimActive    = false   -- controlled by on-screen AIM button on mobile

local function nearestTarget()
    local vps = Camera.ViewportSize
    local mid = Vector2.new(vps.X/2, vps.Y/2)
    local best, bestD = nil, CFG.AIM_FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer or teammate(p) or not alive(p) then continue end
        local bone=getBone(getChar(p),"Head"); if not bone then continue end
        local sc,vis=w2s(bone.Position)
        if vis then
            local d=(mid-sc).Magnitude
            if d<bestD then bestD=d; best=bone end
        end
    end
    return best
end

local function hookSilentAim()
    local remote=ReplicatedStorage:FindFirstChild(SHOOT_REMOTE,true)
    if not remote then
        warn("[LoL Hub] Remote '"..SHOOT_REMOTE.."' not found. Run misc scanner.")
        return
    end
    if not hookfunction then
        warn("[LoL Hub] hookfunction unavailable in this executor")
        return
    end
    local orig=remote.FireServer
    hookfunction(orig, function(self,...)
        if not CFG.AIM_SILENT or not CFG.AIM_ENABLED then return orig(self,...) end
        local t=silentTarget; if not t then return orig(self,...) end
        local args={...}
        local dir=(t.Position-Camera.CFrame.Position).Unit
        if args[1] and typeof(args[1])=="Vector3" then args[1]=dir
        elseif args[2] and typeof(args[2])=="Vector3" then args[2]=dir end
        return orig(self,table.unpack(args))
    end)
    print("[LoL Hub] Silent aim hooked: "..remote:GetFullName())
end

local function updateAimbot()
    local vps=Camera.ViewportSize; local mid=Vector2.new(vps.X/2,vps.Y/2)
    fovCircle.Position=mid; fovCircle.Radius=CFG.AIM_FOV
    fovCircle.Visible=CFG.AIM_DRAW_FOV and CFG.AIM_ENABLED
    silentTarget=nil
    if not CFG.AIM_ENABLED then return end
    local target=nearestTarget(); silentTarget=target
    if not target then return end
    if CFG.AIM_SILENT then return end
    -- smooth cam (non-silent, triggered by aimActive flag on mobile)
    if aimActive then
        local smooth=CFG.AIM_SMOOTH/100
        Camera.CFrame=Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position,target.Position),smooth)
    end
end

