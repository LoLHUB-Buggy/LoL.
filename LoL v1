-- Toggle — works on touch (MouseButton1Click fires on tap)
local function Toggle(parent,label,cfgKey,order)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,ROW_H); row.BackgroundColor3=P.PANEL; row.BorderSizePixel=0; row.LayoutOrder=order or 0; row.Parent=parent
