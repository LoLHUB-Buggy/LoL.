-- ── Helpers ─────────────────────────────────────────────────
local function corner(inst, radius)
    local c = Instance.new("UICorner", inst)
    c.CornerRadius = UDim.new(0, radius or 12)
end

local function stroke(inst, color, thickness)
    local s = Instance.new("UIStroke", inst)
    s.Color     = color or THEME.BORDER
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
end

local function gradient(inst, c0, c1, rot)
    local g = Instance.new("UIGradient", inst)
    g.Color    = ColorSequence.new(c0, c1)
    g.Rotation = rot or 135
end

local function label(parent, text, size, color, font, pos, anc)
    local l = Instance.new("TextLabel", parent)
    l.Text              = text
    l.TextSize          = size or 14
    l.TextColor3        = color or THEME.TEXT
    l.Font              = font or Enum.Font.GothamBold
    l.BackgroundTransparency = 1
    l.Position          = pos or UDim2.new(0,0,0,0)
    l.Size              = UDim2.new(1,0,1,0)
    l.AnchorPoint       = anc or Vector2.new(0,0)
    l.TextXAlignment    = Enum.TextXAlignment.Left
    return l
end

local function tween(obj, props, t, style, dir)
    TweenService:Create(obj,
        TweenInfo.new(t or 0.25, style or Enum.EasingStyle.Quart,
                      dir  or Enum.EasingDirection.Out), props):Play()
end

