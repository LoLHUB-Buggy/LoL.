--  UPDATE UI STATE
-- ══════════════════════════════════════════════════════════
local function updateUI()
    if alignEnabled then
        -- status
        StatusDot.BackgroundColor3 = THEME.ON
        StatusLabel.TextColor3     = THEME.ON
        StatusLabel.Text           = "ACTIVE"
        StatusSub.Text             = "Aligning to camera each frame"
        -- pill
        tween(PillBg,   {BackgroundColor3 = THEME.ON},   0.2)
        tween(PillKnob, {Position = UDim2.new(0,25,0.5,-10)}, 0.2)
        -- toggle card border accent
        tween(ToggleIcon, {TextColor3 = THEME.ON}, 0.2)
    else
        StatusDot.BackgroundColor3 = THEME.OFF
        StatusLabel.TextColor3     = THEME.OFF
        StatusLabel.Text           = "INACTIVE"
        StatusSub.Text             = "Camera alignment is off"
        tween(PillBg,   {BackgroundColor3 = THEME.OFF},  0.2)
        tween(PillKnob, {Position = UDim2.new(0,3,0.5,-10)},  0.2)
        tween(ToggleIcon, {TextColor3 = THEME.SUBTEXT}, 0.2)
    end
end

-- ══════════════════════════════════════════════════════════
--  OPEN / CLOSE PANEL
-- ══════════════════════════════════════════════════════════
local function openPanel()
    guiOpen = true
    Panel.Visible = true
    Panel.Size    = UDim2.new(0, 320, 0, 10)
    Panel.BackgroundTransparency = 1
    tween(Panel, {Size = UDim2.new(0,320,0,420), BackgroundTransparency=0}, 0.3,
          Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    HubIcon.Text = "⊗"
end

local function closePanel()
    guiOpen = false
    tween(Panel, {Size = UDim2.new(0,320,0,10), BackgroundTransparency=1}, 0.22,
          Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    task.delay(0.23, function() Panel.Visible = false end)
    HubIcon.Text = "⊕"
end

-- ══════════════════════════════════════════════════════════
--  TOGGLE ALIGNMENT
-- ══════════════════════════════════════════════════════════
local function toggleAlign()
    alignEnabled = not alignEnabled
    if alignEnabled then enableAlign() else disableAlign() end
    updateUI()
end

-- ══════════════════════════════════════════════════════════
--  DRAGGING  (mouse + touch)
-- ══════════════════════════════════════════════════════════
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging  = true
        dragStart = input.Position
        startPos  = Panel.Position
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                  or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Panel.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offst + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

