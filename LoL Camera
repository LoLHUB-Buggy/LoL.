-- ═══════════════════════════════════════════════════════════
--  CAMERA ALIGNMENT CORE
-- ═══════════════════════════════════════════════════════════
local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function alignToCamera()
    local root = getRoot()
    if not root then return end
    local look = Camera.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.001 then return end
    root.CFrame = CFrame.new(root.Position, root.Position + flat.Unit)
end

local function enableAlign()
    if connection then return end
    connection = RunService.RenderStepped:Connect(alignToCamera)
end

local function disableAlign()
    if connection then connection:Disconnect(); connection = nil end
end

