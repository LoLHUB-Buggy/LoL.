-- ============================================================
--  SERVICES
-- ============================================================
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local Workspace        = game:GetService("Workspace")
local Camera           = Workspace.CurrentCamera

local LocalPlayer      = Players.LocalPlayer
local Mouse            = LocalPlayer:GetMouse()

-- ============================================================
--  PLATFORM DETECTION
-- ============================================================
local IsMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- ============================================================
--  CONFIG
-- ============================================================
local CFG = {
    AimbotEnabled      = true,
    AimKey             = Enum.UserInputType.MouseButton2,
    AimBone            = "Head",
    SmoothFactor       = 1,
    MaxDistance        = 1000,
    TeamCheck          = true,

    SilentAimEnabled   = true,
    SilentAimBone      = "Head",

    TriggerbotEnabled  = true,
    TriggerbotDelay    = 0,
    TriggerbotFOV      = 8,

    RapidFireEnabled   = true,
    RapidFireRate      = 0.02,
}

-- ============================================================
--  UTILITY
-- ============================================================
local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function isAlive(player)
    local char = player.Character
    if not char then return false end
    local hum = getHumanoid(char)
    return hum and hum.Health > 0
end

local function isEnemy(player)
    if not CFG.TeamCheck then return true end
    if player.Team == nil or LocalPlayer.Team == nil then return true end
    return player.Team ~= LocalPlayer.Team
end

local function getBonePosition(player, boneName)
    local char = player.Character
    if not char then return nil end
    local bone = char:FindFirstChild(boneName)
    if bone then return bone.Position end
    local root = getRoot(char)
    return root and root.Position or nil
end

local function worldToViewport(pos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), screenPos.Z, onScreen
end

local function screenDistance(screenPos)
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    return (center - screenPos).Magnitude
end

-- ============================================================
--  TARGET ACQUISITION
-- ============================================================
local function getClosestTarget()
    local bestPlayer = nil
    local bestDist   = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not isEnemy(player) then continue end
        if not isAlive(player) then continue end
        local bonePos = getBonePosition(player, CFG.AimBone)
        if not bonePos then continue end
        local localRoot = getRoot(LocalPlayer.Character)
        if localRoot then
            if (bonePos - localRoot.Position).Magnitude > CFG.MaxDistance then continue end
        end
        local screenPos, depth, onScreen = worldToViewport(bonePos)
        if not onScreen or depth < 0 then continue end
        local dist = screenDistance(screenPos)
        if dist < bestDist then
            bestDist   = dist
            bestPlayer = player
        end
    end
    return bestPlayer, bestDist
end

-- ============================================================
--  SILENT AIM
-- ============================================================
local OriginalIndex = nil
local SilentTarget  = nil

local function enableSilentAim()
    local mt = getrawmetatable(Mouse)
    OriginalIndex = mt.__index
    setreadonly(mt, false)
    mt.__index = function(self, key)
        if CFG.SilentAimEnabled and SilentTarget then
            local bonePos = getBonePosition(SilentTarget, CFG.SilentAimBone)
            if bonePos then
                if key == "Hit" then return CFrame.new(bonePos) end
                if key == "UnitRay" then
                    local camPos = Camera.CFrame.Position
                    return Ray.new(camPos, (bonePos - camPos).Unit * 1000)
                end
            end
        end
        return OriginalIndex(self, key)
    end
    setreadonly(mt, true)
end

-- ============================================================
--  AIMBOT
-- ============================================================
local MobileAiming = false

local function isAimKeyHeld()
    if IsMobile then return MobileAiming end
    return UserInputService:IsMouseButtonPressed(CFG.AimKey)
end

local function runAimbot(target)
    if not target then return end
    local bonePos = getBonePosition(target, CFG.AimBone)
    if not bonePos then return end
    local camCF    = Camera.CFrame
    local targetCF = CFrame.new(camCF.Position, bonePos)
    if CFG.SmoothFactor <= 1 then
        Camera.CFrame = targetCF
    else
        Camera.CFrame = camCF:Lerp(targetCF, 1 / CFG.SmoothFactor)
    end
end

-- ============================================================
--  TRIGGERBOT
-- ============================================================
local triggerDebounce = false

local function simulateClick()
    if mouse1click then mouse1click() end
end

local function runTriggerbot()
    if triggerDebounce then return end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not isEnemy(player) then continue end
        if not isAlive(player) then continue end
        local bonePos = getBonePosition(player, CFG.AimBone)
        if not bonePos then continue end
        local screenPos, depth, onScreen = worldToViewport(bonePos)
        if not onScreen or depth < 0 then continue end
        if (center - screenPos).Magnitude <= CFG.TriggerbotFOV then
            triggerDebounce = true
            task.delay(CFG.TriggerbotDelay, function()
                simulateClick()
                task.wait(0.05)
                triggerDebounce = false
            end)
            break
        end
    end
end

-- ============================================================
--  RAPID FIRE
-- ============================================================
local RapidFireActive = false
local RapidFireThread = nil

local function startRapidFire()
    if RapidFireThread then return end
    RapidFireThread = task.spawn(function()
        while CFG.RapidFireEnabled do
            if RapidFireActive then
                if mouse1click then mouse1click() end
            end
            task.wait(CFG.RapidFireRate)
        end
    end)
end

local function stopRapidFire()
    if RapidFireThread then
        task.cancel(RapidFireThread)
        RapidFireThread = nil
    end
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        RapidFireActive = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        RapidFireActive = false
    end
end)

-- ============================================================
--  SAKADING 1.12.1 — GUI
-- ============================================================
