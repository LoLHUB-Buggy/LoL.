    OpenBtn.Name              = "OpenButton"
    OpenBtn.Size              = UDim2.new(0, 110, 0, 32)
    OpenBtn.Position          = UDim2.new(0, 12, 0, 12)
    OpenBtn.BackgroundColor3  = Color3.fromRGB(18, 18, 28)
    OpenBtn.BorderSizePixel   = 0
    OpenBtn.Text              = "☰ Sakading"
    OpenBtn.TextColor3        = Color3.fromRGB(200, 160, 255)
    OpenBtn.TextSize          = 13
    OpenBtn.Font              = Enum.Font.GothamBold
    OpenBtn.Visible           = false   -- hidden while main panel open
    OpenBtn.Parent            = ScreenGui

    local OpenCorner = Instance.new("UICorner")
    OpenCorner.CornerRadius = UDim.new(0, 6)
    OpenCorner.Parent       = OpenBtn

    -- ── MAIN PANEL ────────────────────────────────────────────
